# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Render'da RENDER_EXTERNAL_HOSTNAME otomatik eklenir; sadece özel alan adı
# (ör. https://www.ornek.com) kullanırsan buraya yaz.
CSRF_TRUSTED_ORIGINS=

# Veritabani (Supabase Postgres connection string)
# Yerel gelistirmede bos birakilirsa otomatik olarak sqlite kullanilir.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/postgres

# Cloudinary (urun gorselleri) — DEBUG=False iken zorunlu, yoksa site acilmaz
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
