# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Veritabani (Supabase Postgres connection string)
# Yerel gelistirmede bos birakilirsa otomatik olarak sqlite kullanilir.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/postgres

# Cloudinary (urun gorselleri)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
